AZURE_DEVOPS_ORGANIZATION=your-organization
AZURE_DEVOPS_PROJECT=your-project
AZURE_DEVOPS_PAT=replace-with-a-narrowly-scoped-pat
# Your Azure DevOps ID, display name, or unique name/email.
# Used to fetch PRs you created or that are assigned to you.
AZURE_DEVOPS_REVIEWER=you@example.com

# AI models are managed in the dashboard Models page.
DAILY_COST_CAP_USD=1.00

# Generate a random value of at least 16 characters.
DASHBOARD_AUTH_TOKEN=replace-with-a-long-random-token
FRONTEND_ORIGINS=http://localhost:5173,http://pr-reviewer-frontend
POLL_INTERVAL_MINUTES=5
MAX_CHANGED_LINES=3000
# Default on startup; can also be toggled from the dashboard.
AUTO_PR_REVIEW_ENABLED=false
DATABASE_URL=sqlite+aiosqlite:///./data/pr_reviewer.db
